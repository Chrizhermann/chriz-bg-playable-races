// Chriz BG Playable Races: monster protagonists built at install time from the installed
// game's own creature files. Ships no game art or audio.
BACKUP ~chriz-bg-playable-races/backup~
AUTHOR ~Chriz~
VERSION ~v0.2.0-proto~

ALWAYS
  INCLUDE ~chriz-bg-playable-races/lib/hg_functions.tpa~
  // EE Soundset Tool helper by CamDawg and Graion Dilach, unchanged.
  INCLUDE ~chriz-bg-playable-races/lib/cd_add_soundset.tph~
END

LANGUAGE ~English~ ~english~ ~chriz-bg-playable-races/lang/english/setup.tra~

// Hobgoblin protagonist: race HOBGOBLIN in character creation, with the rules of a template
// race (half-orc, or human), and the hobgoblin sprite with weapon and armour looks.
// Companions keep their own looks.
BEGIN @1 DESIGNATED 100
SUBCOMPONENT @9
LABEL ~cbpr_hobgoblin_protagonist~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~8100.ini~ AND FILE_EXISTS_IN_GAME ~mhobg1.bam~
                   AND FILE_EXISTS_IN_GAME ~mhobsg1.bam~ AND FILE_EXISTS_IN_GAME ~mhobbg1.bam~) @2
OUTER_SET hg_template_race = 7     // HALFORC
INCLUDE ~chriz-bg-playable-races/hobgoblin/hobgoblin.tpa~

BEGIN @16 DESIGNATED 101
SUBCOMPONENT @9
LABEL ~cbpr_hobgoblin_protagonist_human_rules~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~8100.ini~ AND FILE_EXISTS_IN_GAME ~mhobg1.bam~
                   AND FILE_EXISTS_IN_GAME ~mhobsg1.bam~ AND FILE_EXISTS_IN_GAME ~mhobbg1.bam~) @2
OUTER_SET hg_template_race = 1     // HUMAN
INCLUDE ~chriz-bg-playable-races/hobgoblin/hobgoblin.tpa~
