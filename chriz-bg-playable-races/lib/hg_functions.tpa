// Helper functions for the hobgoblin protagonist prototype.

// Four-digit upper-case hex text of a non-negative integer (animation slot -> INI name).
DEFINE_ACTION_FUNCTION hg_hex4
  INT_VAR value = 0
  RET hex
BEGIN
  OUTER_SPRINT hex ~~
  OUTER_SET rest = value
  OUTER_FOR (i = 0; i < 4; ++i) BEGIN
    OUTER_SET d = rest MODULO 16
    OUTER_SET rest = rest / 16
    OUTER_PATCH ~0123456789ABCDEF~ BEGIN
      READ_ASCII d digit (1)
    END
    OUTER_SPRINT hex ~%digit%%hex%~
  END
  ACTION_IF rest != 0 BEGIN
    FAIL ~hg_hex4: %value% does not fit in four hex digits~
  END
END

// First animation slot in [slot_min, slot_max) that has neither an ANIMATE.IDS symbol
// nor an INI resource. Returns -1 when the range is full.
DEFINE_ACTION_FUNCTION hg_find_free_anim_slot
  INT_VAR slot_min = 0
          slot_max = 0
  RET slot
BEGIN
  ACTION_IF slot_max <= slot_min BEGIN
    OUTER_SET slot_max = (slot_min BAND 0xF000) + 0x1000
  END
  OUTER_SET slot = 0 - 1
  OUTER_FOR (idx = slot_min; idx < slot_max; ++idx) BEGIN
    OUTER_PATCH ~~ BEGIN
      LOOKUP_IDS_SYMBOL_OF_INT name ~animate~ idx
    END
    ACTION_IF (~%name%~ STRING_EQUAL ~%idx%~) BEGIN
      LAF hg_hex4 INT_VAR value = idx RET hex END
      ACTION_IF NOT FILE_EXISTS_IN_GAME ~%hex%.ini~ BEGIN
        OUTER_SET slot = idx
        OUTER_SET idx = slot_max
      END
    END
  END
END

// Turn a BAMC (zlib) buffer into a plain BAM V1 buffer; fail on anything else.
DEFINE_PATCH_FUNCTION hg_bam_decompress BEGIN
  READ_ASCII 0 sig (8)
  PATCH_IF (~%sig%~ STRING_EQUAL ~BAMCV1  ~) BEGIN
    READ_LONG 8 ulen
    DECOMPRESS_REPLACE_FILE 12 (BUFFER_LENGTH - 12) ulen
    READ_ASCII 0 sig (8)
  END
  PATCH_IF NOT (~%sig%~ STRING_EQUAL ~BAM V1  ~) BEGIN
    PATCH_FAIL ~%SOURCE_FILE% is not a BAM V1/BAMC file (signature "%sig%")~
  END
END

// Point cycles [to, to+count) at the same frames as cycles [from, from+count).
DEFINE_PATCH_FUNCTION hg_bam_copy_cycles
  INT_VAR from = 0
          to = 16
          count = 8
BEGIN
  READ_SHORT 0x08 nfr
  READ_BYTE  0x0a ncy
  READ_LONG  0x0c fo
  PATCH_IF ((from + count > ncy) OR (to + count > ncy)) BEGIN
    PATCH_FAIL ~%SOURCE_FILE% has %ncy% cycles; cannot map cycles %from%+%count% to %to%~
  END
  FOR (i = 0; i < count; ++i) BEGIN
    READ_LONG (fo + nfr * 12 + (from + i) * 4) entry
    WRITE_LONG (fo + nfr * 12 + (to + i) * 4) entry
  END
END

// Copy one game BAM to a new name, decompressed, optionally mapping the two-handed
// attack cycles (16-23) onto the one-handed slash cycles (0-7).
DEFINE_ACTION_FUNCTION hg_copy_bam
  INT_VAR remap_2h = 0
  STR_VAR src = ~~
          dst = ~~
BEGIN
  COPY_EXISTING ~%src%.bam~ ~override/%dst%.bam~
    LPF hg_bam_decompress END
    PATCH_IF remap_2h BEGIN
      LPF hg_bam_copy_cycles INT_VAR from = 0 to = 16 count = 8 END
    END
END

// Write one EFF V2.0 file applying opcode 53 (animation change) while equipped.
// kind 2 mirrors the engine's own item-driven animation switches (SoD M'Khiin).
// The parent resource must name the EFF itself, as in CDMK25.EFF: opcode 318/206
// immunities match the applied effect's parent resource, so without it the item's
// op318 guard never blocks and every wielder changes sprite (lab-verified).
DEFINE_ACTION_FUNCTION hg_make_anim_eff
  INT_VAR anim = 0
          kind = 2
  STR_VAR name = ~~
BEGIN
  LAF hg_make_eq_eff INT_VAR opcode = 53 parameter1 = anim parameter2 = kind STR_VAR name END
END

// Write one EFF V2.0 file holding a single self-targeted effect (default: while equipped)
// whose parent resource is the EFF itself (see hg_make_anim_eff for why the parent matters).
DEFINE_ACTION_FUNCTION hg_make_eq_eff
  INT_VAR opcode = 0
          parameter1 = 0
          parameter2 = 0
          timing = 2
          duration = 0
  STR_VAR name = ~~
          resource = ~~
BEGIN
  OUTER_SPRINT parent ~%name%~
  ACTION_TO_UPPER ~parent~
  OUTER_SET len = STRING_LENGTH ~%name%~
  ACTION_IF (len < 1) OR (len > 8) BEGIN
    FAIL ~hg_make_eq_eff: "%name%" is not a valid resource name~
  END
  CREATE ~EFF~ ~%name%~
    WRITE_LONG 0x10 opcode
    WRITE_LONG 0x14 1       // target: self
    WRITE_LONG 0x1c parameter1
    WRITE_LONG 0x20 parameter2
    WRITE_SHORT 0x24 timing
    WRITE_LONG 0x28 duration
    WRITE_SHORT 0x2c 100    // probability 1
    WRITE_SHORT 0x2e 0      // probability 2
    PATCH_IF NOT (~%resource%~ STRING_EQUAL ~~) BEGIN
      WRITE_ASCIIE 0x30 ~%resource%~ #8
    END
    WRITE_LONG 0x90 1       // parent resource type: spell
    WRITE_ASCIIE 0x94 ~%parent%~ #8   // parent resource: this EFF
END

// Give the current ITM one PC-only switch: an equipped effect applies the EFF while the item
// is equipped, op318 in front of it shields every creature without the marker spell state.
// Default op177 runs the EFF's effect inside itself every tick (fine for opcode 53, but colour
// changes made that way never show); op272 (apply_p1 = 1, apply_p2 = 0: once per second)
// attaches the EFF to the creature instead. op318 does not stop op272 (lab run 5), so an
// op272 EFF has to check the creature itself and is added with guard = 0.
// Skips an item that already carries this switch.
DEFINE_PATCH_FUNCTION hg_add_switch
  INT_VAR splstate = 0
          splprot_row = 0
          guard = 1
          apply_opcode = 177
          apply_p1 = 0
          apply_p2 = 2
  STR_VAR eff = ~~
BEGIN
  READ_LONG  0x6a fx_off
  READ_SHORT 0x6e fx_idx
  READ_SHORT 0x70 fx_n
  SET done = 0
  FOR (i = 0; i < fx_n; ++i) BEGIN
    READ_SHORT (fx_off + (fx_idx + i) * 0x30) op
    READ_ASCII (fx_off + (fx_idx + i) * 0x30 + 0x14) res (8) NULL
    PATCH_IF (op = apply_opcode) AND (~%res%~ STRING_EQUAL_CASE ~%eff%~) BEGIN SET done = 1 END
  END
  PATCH_IF NOT done BEGIN
    // ADD_ITEM_EQEFFECT inserts at the top of the list: add the switch first so the
    // guard ends up in front of it, as in the installed M'Khiin weapons.
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = apply_opcode target = 1 timing = 2 parameter1 = apply_p1
      parameter2 = apply_p2 STR_VAR resource = EVAL ~%eff%~ END
    PATCH_IF guard BEGIN
      LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 318 target = 1 timing = 2 parameter1 = splstate
        parameter2 = splprot_row STR_VAR resource = EVAL ~%eff%~ END
    END
  END
END

// 0-based SPLPROT.2DA data row for (stat, value, relation), the first match; appends a row
// labelled `label` when the table has none. Rows with a non-numeric cell never match.
DEFINE_ACTION_FUNCTION hg_splprot_row
  INT_VAR stat = 0
          value = 0
          relation = 0
  STR_VAR label = ~~
  RET row
BEGIN
  OUTER_SET row = 0 - 1
  COPY_EXISTING ~splprot.2da~ ~override~
    COUNT_2DA_ROWS 4 nrows
    FOR (r = 0; r < nrows; ++r) BEGIN
      READ_2DA_ENTRY r 1 4 st
      READ_2DA_ENTRY r 2 4 va
      READ_2DA_ENTRY r 3 4 re
      PATCH_IF (row < 0) AND (IS_AN_INT st) AND (IS_AN_INT va) AND (IS_AN_INT re) BEGIN
        PATCH_IF (st = stat) AND (va = value) AND (re = relation) BEGIN
          SET row = r
        END
      END
    END
    PATCH_IF (row < 0) BEGIN
      INSERT_2DA_ROW nrows 4 ~%label% %stat% %value% %relation%~
      SET row = nrows
    END
  BUT_ONLY
END

// Turn the buffer of a fresh CREATE ~SPL~ into a nameless innate level-1 spell with one
// ability (standard, innate, targets the caster, no projectile) and no effects yet.
DEFINE_PATCH_FUNCTION hg_spl_init BEGIN
  PATCH_IF (BUFFER_LENGTH != 0x72) BEGIN PATCH_FAIL ~hg_spl_init: unexpected new SPL size~ END
  WRITE_LONG 0x08 (0 - 1)     // no names or descriptions
  WRITE_LONG 0x0c (0 - 1)
  WRITE_LONG 0x50 (0 - 1)
  WRITE_LONG 0x54 (0 - 1)
  WRITE_SHORT 0x1c 4          // innate
  WRITE_LONG 0x34 1           // level 1
  INSERT_BYTES 0x72 0x28      // one ability header
  WRITE_LONG  0x64 0x72       // abilities offset
  WRITE_SHORT 0x68 1          // abilities count
  WRITE_LONG  0x6a 0x9a       // effects offset
  WRITE_SHORT 0x6e 0          // casting effects index
  WRITE_SHORT 0x70 0          // casting effects count
  WRITE_BYTE  0x72 1          // ability form: standard
  WRITE_SHORT 0x74 4          // location: innate
  WRITE_BYTE  0x7e 5          // target: caster
  WRITE_SHORT 0x82 1          // level
  WRITE_SHORT 0x98 1          // projectile: none
END

// Innate spell, nameless, that gives its target the metal and armor colour ranges `metal`
// and the major range `cloak` for `duration` seconds. Meant for opcode 326, which applies it
// to its own target; its effects use target 2 like the game's own op326 spells (BDBOW04).
DEFINE_ACTION_FUNCTION hg_make_colour_spl
  INT_VAR metal = 0
          cloak = 0
          duration = 3
  STR_VAR name = ~~
BEGIN
  CREATE ~SPL~ ~%name%~
    LPF hg_spl_init END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = metal parameter2 = 0 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = metal parameter2 = 5 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = cloak parameter2 = 2 END
END

// Private animation INI derived from the installed hobgoblin INI: given walking speed,
// body resref and the two weapon look codes it draws; no animation-level selection or
// battle-cry voice (the PC's soundset owns those).
DEFINE_ACTION_FUNCTION hg_make_ini
  INT_VAR slot = 0
          move = 9
  STR_VAR body = ~~
          w1 = ~~
          w2 = ~~
BEGIN
  LAF hg_hex4 INT_VAR value = slot RET hex END
  COPY_EXISTING ~8100.ini~ ~override/%hex%.ini~
    COUNT_REGEXP_INSTANCES ~^resref[ %TAB%]*=~ n_resref
    PATCH_IF (n_resref != 1) BEGIN
      PATCH_FAIL ~8100.ini: expected exactly one "resref=" line, found %n_resref%~
    END
    REPLACE_TEXTUALLY ~^\(move_scale[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%move%~
    REPLACE_TEXTUALLY ~^\(resref[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%body%~
    COUNT_REGEXP_INSTANCES ~^resref_weapon1[ %TAB%]*=~ n_w1
    PATCH_IF (n_w1 = 0) BEGIN
      REPLACE_TEXTUALLY ~^\(resref[ %TAB%]*=[^%MNL%%LNL%]*\)~ ~\1%WNL%resref_weapon1=%w1%%WNL%resref_weapon2=%w2%~
    END ELSE BEGIN
      REPLACE_TEXTUALLY ~^\(resref_weapon1[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%w1%~
      REPLACE_TEXTUALLY ~^\(resref_weapon2[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%w2%~
    END
    REPLACE_TEXTUALLY ~^\(selection[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1~
    REPLACE_TEXTUALLY ~^\(battle_cry[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1~
END

// Inventory figure from the current (decompressed) creature BAM: frame 0 of `cycle`, scaled
// up `scale` times, as a BAM of two frames (the figure and a 1x1 blank) with one cycle
// (0, 0, 1) and the source palette. The centre (cx, cy) places it on the paperdoll; the
// defaults are the values the lab prototype showed correctly. The blank pixel is the
// palette's transparent colour (as the engine picks it: the first RGB(0,255,0) entry, else
// entry 0), and the header keeps the source's RLE index, so a replaced creature BAM that
// uses other indices for them still gives a clean figure.
DEFINE_PATCH_FUNCTION hg_bam_inv_figure
  INT_VAR cycle = 16
          scale = 2
          cx = 0 - 4
          cy = 0 - 16
BEGIN
  READ_SHORT 0x08 nfr
  READ_BYTE  0x0a ncy
  READ_BYTE  0x0b rle
  READ_LONG  0x0c fo
  READ_LONG  0x10 po
  READ_LONG  0x14 lo
  PATCH_IF (cycle >= ncy) BEGIN PATCH_FAIL ~%SOURCE_FILE% has no cycle %cycle%~ END
  READ_SHORT (fo + nfr * 12 + cycle * 4) ccount
  READ_SHORT (fo + nfr * 12 + cycle * 4 + 2) cfirst
  PATCH_IF (ccount < 1) BEGIN PATCH_FAIL ~%SOURCE_FILE%: cycle %cycle% is empty~ END
  READ_SHORT (lo + cfirst * 2) fi
  PATCH_IF (fi >= nfr) BEGIN PATCH_FAIL ~%SOURCE_FILE%: cycle %cycle% names frame %fi% of %nfr%~ END
  READ_SHORT (fo + fi * 12)     w
  READ_SHORT (fo + fi * 12 + 2) h
  READ_LONG  (fo + fi * 12 + 8) doff
  SET raw = ((doff BAND 0x80000000) != 0)
  SET doff = (doff BAND 0x7FFFFFFF)
  SET old = BUFFER_LENGTH
  // Decode the frame (RLE: the compressed index is followed by a count of extra copies)
  // into a scratch area behind the original data.
  SET dec = old
  INSERT_BYTES dec (w * h)
  SET i = 0
  SET p = doff
  WHILE (i < w * h) BEGIN
    PATCH_IF (p >= old) BEGIN PATCH_FAIL ~%SOURCE_FILE%: frame %fi% data ends early~ END
    READ_BYTE p b
    SET p += 1
    PATCH_IF (NOT raw) AND (b = rle) BEGIN
      PATCH_IF (p >= old) BEGIN PATCH_FAIL ~%SOURCE_FILE%: frame %fi% data ends early~ END
      READ_BYTE p run
      SET p += 1
      FOR (k = 0; (k <= run) AND (i < w * h); ++k) BEGIN
        WRITE_BYTE (dec + i) rle
        SET i += 1
      END
    END ELSE BEGIN
      WRITE_BYTE (dec + i) b
      SET i += 1
    END
  END
  // Build the figure BAM behind the scratch area, then drop everything in front of it.
  SET bw = w * scale
  SET bh = h * scale
  SET nb = dec + w * h
  SET b_fo = 0x18                 // two frame entries
  SET b_co = b_fo + 2 * 12        // one cycle entry
  SET b_po = b_co + 4             // palette
  SET b_lo = b_po + 1024          // lookup table
  SET b_do = b_lo + 3 * 2         // figure pixels, then the blank frame's pixel
  INSERT_BYTES nb (b_do + bw * bh + 1)
  WRITE_ASCII nb ~BAM V1  ~
  WRITE_SHORT (nb + 0x08) 2
  WRITE_BYTE  (nb + 0x0a) 1
  WRITE_BYTE  (nb + 0x0b) rle
  WRITE_LONG  (nb + 0x0c) b_fo
  WRITE_LONG  (nb + 0x10) b_po
  WRITE_LONG  (nb + 0x14) b_lo
  WRITE_SHORT (nb + b_fo)      bw
  WRITE_SHORT (nb + b_fo + 2)  bh
  WRITE_SHORT (nb + b_fo + 4)  cx
  WRITE_SHORT (nb + b_fo + 6)  cy
  WRITE_LONG  (nb + b_fo + 8)  (0x80000000 BOR b_do)
  WRITE_SHORT (nb + b_fo + 12) 1
  WRITE_SHORT (nb + b_fo + 14) 1
  WRITE_LONG  (nb + b_fo + 20) (0x80000000 BOR (b_do + bw * bh))
  WRITE_SHORT (nb + b_co)      3
  WRITE_SHORT (nb + b_co + 2)  0
  SET tr = 0 - 1
  FOR (c = 0; c < 256; ++c) BEGIN
    READ_LONG (po + c * 4) col
    WRITE_LONG (nb + b_po + c * 4) col
    PATCH_IF (tr < 0) AND ((col BAND 0xFFFFFF) = 0x00FF00) BEGIN SET tr = c END
  END
  WRITE_BYTE (nb + b_do + bw * bh) ((tr < 0) ? 0 : tr)
  WRITE_SHORT (nb + b_lo + 4) 1
  FOR (y = 0; y < bh; ++y) BEGIN
    FOR (x = 0; x < bw; ++x) BEGIN
      READ_BYTE (dec + (y / scale) * w + (x / scale)) v
      WRITE_BYTE (nb + b_do + y * bw + x) v
    END
  END
  DELETE_BYTES 0 nb
END

// Subtitles of sound clips, from the current TLK V1 buffer. `clips`: resrefs separated by
// spaces (any case). For each clip some string plays, `texts` (key: the clip in upper case)
// gets the text of the lowest such string, without a leading "[TAG]", without "~" and
// trimmed; a string that keeps some text wins over one that keeps none. Nothing for a
// buffer that is no TLK V1.
DEFINE_PATCH_FUNCTION hg_tlk_clip_texts
  STR_VAR clips = ~~
  RET_ARRAY texts
BEGIN
  CLEAR_ARRAY texts
  // Per wanted clip: 0 no string seen yet, 1 only strings without text, 2 text found.
  CLEAR_ARRAY hgt_state
  INNER_PATCH ~%clips%~ BEGIN
    REPLACE_EVALUATE ~\([^ %TAB%]+\)~ BEGIN
      SPRINT clip ~%MATCH1%~
      TO_UPPER clip
      SET $hgt_state(~%clip%~) = 0
    END ~%MATCH1%~
  END
  READ_ASCII 0 sig (8)
  PATCH_IF (~%sig%~ STRING_EQUAL ~TLK V1  ~) BEGIN
    READ_LONG 0x0a count
    READ_LONG 0x0e start
    FOR (i = 0; i < count; ++i) BEGIN
      SET e = 0x12 + i * 0x1a
      READ_BYTE (e + 2) c
      PATCH_IF (c != 0) BEGIN
        READ_ASCII (e + 2) snd (8) NULL
        TO_UPPER snd
        PATCH_IF VARIABLE_IS_SET EVAL ~hgt_state_%snd%~ BEGIN
          PATCH_IF ($hgt_state(~%snd%~) < 2) BEGIN
            READ_LONG (e + 0x12) off
            READ_LONG (e + 0x16) len
            SPRINT text ~~
            PATCH_IF (len > 0) BEGIN
              READ_ASCII (start + off) text (len)
            END
            INNER_PATCH_SAVE text ~%text%~ BEGIN
              REPLACE_TEXTUALLY ~^[ %TAB%]*[[][^]]*[]]~ ~~
              REPLACE_TEXTUALLY "~" ""
              REPLACE_TEXTUALLY ~^[ %TAB%]+~ ~~
              REPLACE_TEXTUALLY ~[ %TAB%]+$~ ~~
            END
            PATCH_IF (STRING_LENGTH ~%text%~ > 0) BEGIN
              SPRINT $texts(~%snd%~) ~%text%~
              SET $hgt_state(~%snd%~) = 2
            END ELSE PATCH_IF ($hgt_state(~%snd%~) = 0) BEGIN
              SPRINT $texts(~%snd%~) ~~
              SET $hgt_state(~%snd%~) = 1
            END
          END
        END
      END
    END
  END
END

// Layout of the 2DA table in the buffer, for READ_2DA_ENTRY: `ncols` entries in a data row
// (row label included), the data rows `drow` to `drow + nrows - 1` read with `ncols`, and
// the column-name line as row `hrow` read with `ncols - 1`. READ_2DA_ENTRY and
// COUNT_2DA_ROWS count only lines with at least that many entries, so with one or two
// columns the signature line "2DA V1.0" (two entries) and the default value line (one)
// count as well, in front. `ncols` comes from the column-name line (the third line), not
// from COUNT_2DA_COLS: that counts the longest line, so a table without data rows (the
// CAMPAIGN.2DA of BG:EE and BG2:EE 2.7) would read its column names as a data row.
DEFINE_PATCH_FUNCTION hg_2da_layout
  RET ncols drow nrows hrow
BEGIN
  SET p = 0
  SET line = 0
  WHILE (line < 2) AND (p < BUFFER_LENGTH) BEGIN
    READ_BYTE p ch
    SET p += 1
    PATCH_IF (ch = 10) BEGIN SET line += 1 END
  END
  SET names = 0
  SET in_name = 0
  SET ch = 0
  WHILE (p < BUFFER_LENGTH) AND (ch != 10) BEGIN
    READ_BYTE p ch
    SET p += 1
    PATCH_IF (ch = 32) OR (ch = 9) OR (ch = 13) OR (ch = 10) BEGIN
      SET in_name = 0
    END ELSE PATCH_IF NOT in_name BEGIN
      SET in_name = 1
      SET names += 1
    END
  END
  SET ncols = names + 1
  SET hrow = ((ncols - 1 <= 2) ? 1 : 0) + ((ncols - 1 <= 1) ? 1 : 0)
  SET drow = (ncols <= 2) ? 1 : 0
  SET nrows = 0
  PATCH_IF (ncols >= 2) BEGIN
    COUNT_2DA_ROWS ncols n
    SET nrows = n - drow
  END
END

// Data-row index of the column `name` in the 2DA table in the buffer (1 = the first column
// after the row label), 0 when there is none.
DEFINE_PATCH_FUNCTION hg_2da_column
  STR_VAR name = ~~
  RET column
BEGIN
  LPF hg_2da_layout RET ncols hrow END
  SET column = 0
  FOR (c = 0; (c < ncols - 1) AND (column = 0); ++c) BEGIN
    READ_2DA_ENTRY hrow c (ncols - 1) head
    PATCH_IF (~%head%~ STRING_EQUAL_CASE ~%name%~) BEGIN SET column = c + 1 END
  END
END

// The entries of the column `name` (the first of that name) in the current CAMPAIGN.2DA
// buffer, upper case, as the keys of `values` ("*" left out); empty without such a column.
DEFINE_PATCH_FUNCTION hg_campaign_column
  STR_VAR name = ~~
  RET_ARRAY values
BEGIN
  CLEAR_ARRAY values
  LPF hg_2da_column STR_VAR name = EVAL ~%name%~ RET col = column END
  PATCH_IF (col > 0) BEGIN
    LPF hg_2da_layout RET ncols drow nrows END
    FOR (r = drow; r < drow + nrows; ++r) BEGIN
      READ_2DA_ENTRY r col ncols v
      TO_UPPER ~v~
      PATCH_IF NOT (~%v%~ STRING_EQUAL ~*~) BEGIN
        SPRINT $values(~%v%~) ~%v%~
      END
    END
  END
END

// The world scripts named in the current CAMPAIGN.2DA buffer (column WORLDSCRIPT), upper
// case, as the keys of `scripts`; empty without such a column.
DEFINE_PATCH_FUNCTION hg_campaign_world_scripts
  RET_ARRAY scripts
BEGIN
  CLEAR_ARRAY scripts
  LPF hg_campaign_column STR_VAR name = ~WORLDSCRIPT~ RET_ARRAY scripts = values END
END

// Does the current CHARSND.2DA buffer have the layout the engine expects (exactly 99 rows,
// labelled 1-99 in order)? Another layout would put sounds into the wrong slots. `present`
// tells whether it already has a column `name`.
DEFINE_PATCH_FUNCTION hg_charsnd_check
  STR_VAR name = ~~
  RET ok
      present
BEGIN
  LPF hg_2da_layout RET ncols drow nrows END
  SET ok = (nrows = 99)
  FOR (r = 0; ok AND (r < nrows); ++r) BEGIN
    READ_2DA_ENTRY (drow + r) 0 ncols label
    SET ok = (IS_AN_INT label) AND (label = r + 1)
  END
  LPF hg_2da_column STR_VAR name RET column END
  SET present = (column > 0)
END

// Inventory figure resource `dst` from frame 0 of `cycle` of the game's BAM `src`.
DEFINE_ACTION_FUNCTION hg_make_inv_bam
  INT_VAR cycle = 16
  STR_VAR src = ~~
          dst = ~~
BEGIN
  COPY_EXISTING ~%src%.bam~ ~override/%dst%.bam~
    LPF hg_bam_decompress END
    LPF hg_bam_inv_figure INT_VAR cycle END
END

// Put the script `baf` (compiled with EVALUATE_BUFFER) on top of every world script the
// game's campaigns run (CAMPAIGN.2DA), each once; BALDUR.BCS when the table names none.
// Returns how many scripts were extended.
DEFINE_ACTION_FUNCTION hg_extend_world_scripts
  STR_VAR baf = ~~
  RET count
BEGIN
  ACTION_CLEAR_ARRAY hgw_scripts
  ACTION_IF FILE_EXISTS_IN_GAME ~campaign.2da~ BEGIN
    COPY_EXISTING - ~campaign.2da~ ~override~
      LPF hg_campaign_world_scripts RET_ARRAY hgw_scripts = scripts END
  END
  OUTER_SET count = 0
  ACTION_PHP_EACH hgw_scripts AS ws => v BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%ws%.bcs~ BEGIN
      EXTEND_TOP ~%ws%.bcs~ ~%baf%~ EVALUATE_BUFFER
      OUTER_SET count += 1
    END
  END
  ACTION_IF (count = 0) BEGIN
    EXTEND_TOP ~baldur.bcs~ ~%baf%~ EVALUATE_BUFFER
    OUTER_SET count = 1
  END
END

// A curated player voice set `name` (1-6 characters) from sound clips the game already
// has, registered with the EE Soundset Tool's cd_add_soundset (cd_add_soundset.tph, kept
// unchanged next to this library). Each STR_VAR clip_<slot> names the clip (a WAV
// resource) for one of the tool's slots, e.g. clip_action1 = ~HOBGL03~; one clip may serve
// several slots. Each filled slot gets its own copy of its clip under the tool's file name
// for the slot: the name plus one character into lang/<language>/sounds (the voice menu
// lists the voices found there), plus two characters into override. Its line is the game's
// own subtitle for the clip (hg_tlk_clip_texts) with that copy as sound; `tra` is a
// scratch file in the mod folder for these lines. A clip the game lacks leaves its slots
// empty (warned). Returns the filled slots; 0 (warned, nothing changed) when CHARSND.2DA
// lacks the 99 numbered rows, when the name is taken (a CHARSND.2DA column, an M_cdsnd.lua
// menu name or a sound file the voice would write), or when no clip fills a one-character
// slot (the menu would not list the voice). Damage 2 and 3 are not offered: the tool drops
// them, as they make the damage line play only part of the time.
DEFINE_ACTION_FUNCTION hg_clip_voice
  INT_VAR display = 0 - 1
  STR_VAR name = ~~
          tra = ~~
          clip_action1 = ~~
          clip_action2 = ~~
          clip_action3 = ~~
          clip_action4 = ~~
          clip_action5 = ~~
          clip_action6 = ~~
          clip_action7 = ~~
          clip_action_rare1 = ~~
          clip_action_rare2 = ~~
          clip_attack1 = ~~
          clip_attack2 = ~~
          clip_attack3 = ~~
          clip_attack4 = ~~
          clip_battlecry1 = ~~
          clip_battlecry2 = ~~
          clip_battlecry3 = ~~
          clip_battlecry4 = ~~
          clip_battlecry5 = ~~
          clip_bored1 = ~~
          clip_bored2 = ~~
          clip_breaking_pt = ~~
          clip_city = ~~
          clip_common1 = ~~
          clip_common2 = ~~
          clip_common3 = ~~
          clip_common4 = ~~
          clip_common5 = ~~
          clip_common6 = ~~
          clip_common7 = ~~
          clip_criticalhit = ~~
          clip_criticalmiss = ~~
          clip_damage1 = ~~
          clip_day = ~~
          clip_disrupted = ~~
          clip_dungeon = ~~
          clip_dying1 = ~~
          clip_dying2 = ~~
          clip_forest = ~~
          clip_gen_death1 = ~~
          clip_gen_death2 = ~~
          clip_happy = ~~
          clip_hurt1 = ~~
          clip_hurt2 = ~~
          clip_immune = ~~
          clip_inventory = ~~
          clip_leader1 = ~~
          clip_leader2 = ~~
          clip_morale_break1 = ~~
          clip_morale_break2 = ~~
          clip_night = ~~
          clip_pickpocket = ~~
          clip_select_rare1 = ~~
          clip_select_rare2 = ~~
          clip_select_rare3 = ~~
          clip_select_rare4 = ~~
          clip_shadows = ~~
          clip_tired1 = ~~
          clip_tired2 = ~~
          clip_trap = ~~
          clip_unhappy_1 = ~~
          clip_unhappy_2 = ~~
  RET slots
BEGIN
  ACTION_IF (STRING_LENGTH ~%name%~ < 1) OR (STRING_LENGTH ~%name%~ > 6) BEGIN
    FAIL ~hg_clip_voice: voice name "%name%" needs 1-6 characters (file names add up to two).~
  END
  ACTION_TO_UPPER name
  // The tool's slots and the file name suffix it gives each (cd_add_soundset.tph).
  ACTION_DEFINE_ASSOCIATIVE_ARRAY hgc_suffix BEGIN
    action1 => i          action2 => j          action3 => k          action4 => s
    action5 => t          action6 => u          action7 => v          action_rare1 => x
    action_rare2 => y     attack1 => c_         attack2 => d_         attack3 => e_
    attack4 => f_         battlecry1 => a       battlecry2 => 8       battlecry3 => 9
    battlecry4 => g_      battlecry5 => h_      bored1 => d           bored2 => i_
    breaking_pt => j_     city => o             common1 => f          common2 => g
    common3 => h          common4 => 0          common5 => k_         common6 => l_
    common7 => m_         criticalhit => z      criticalmiss => 1     damage1 => l
    day => q              disrupted => 6        dungeon => p          dying1 => m
    dying2 => p_          forest => n           gen_death1 => w       gen_death2 => q_
    happy => r_           hurt1 => e            hurt2 => s_           immune => 2
    inventory => 3        leader1 => b          leader2 => t_         morale_break1 => u_
    morale_break2 => v_   night => r            pickpocket => 4       select_rare1 => w_
    select_rare2 => x_    select_rare3 => y_    select_rare4 => z_    shadows => 5
    tired1 => c           tired2 => 4_          trap => 7             unhappy_1 => 5_
    unhappy_2 => 6_
  END
  OUTER_SET slots = 0
  OUTER_SET ok = 0
  OUTER_SET present = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~charsnd.2da~ BEGIN
    COPY_EXISTING - ~charsnd.2da~ ~override~
      LPF hg_charsnd_check STR_VAR name RET ok present END
  END
  OUTER_SET named = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~m_cdsnd.lua~ BEGIN
    COPY_EXISTING - ~m_cdsnd.lua~ ~override~
      LPF hg_menu_named STR_VAR name RET named END
  END
  // The filled slots: their files, files that exist already, clips the game lacks.
  OUTER_SPRINT clash ~~
  OUTER_SPRINT missing ~~
  OUTER_SPRINT wanted ~~
  OUTER_SET listed = 0
  ACTION_PHP_EACH hgc_suffix AS slot => suffix BEGIN
    OUTER_SPRINT clip $clip(~%slot%~)
    OUTER_SPRINT $hgc_file(~%slot%~) ~~
    OUTER_SET $hgc_ref(~%slot%~) = 0 - 1
    ACTION_IF NOT (~%clip%~ STRING_EQUAL ~~) BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%clip%.wav~ BEGIN
        OUTER_SPRINT file ~%name%%suffix%~
        OUTER_SPRINT $hgc_file(~%slot%~) ~%file%~
        OUTER_SPRINT wanted ~%wanted% %clip%~
        ACTION_IF (STRING_LENGTH ~%suffix%~ = 1) BEGIN
          OUTER_SET listed += 1
        END
        ACTION_IF FILE_EXISTS_IN_GAME ~%file%.wav~ OR FILE_EXISTS ~lang/%EE_LANGUAGE%/sounds/%file%.wav~ BEGIN
          OUTER_SPRINT clash ~%file%.wav~
        END
      END ELSE BEGIN
        OUTER_SPRINT missing ~%missing% %clip% (%slot%)~
      END
    END
  END
  ACTION_IF NOT ok BEGIN
    WARN ~CHARSND.2DA is missing or lacks the 99 numbered rows the engine expects; no %name% voice set.~
  END ELSE ACTION_IF present OR named BEGIN
    WARN ~The voice name %name% is taken (CHARSND.2DA column or M_cdsnd.lua menu name); no voice set.~
  END ELSE ACTION_IF NOT (~%clash%~ STRING_EQUAL ~~) BEGIN
    WARN ~A sound file %clash% exists already; no %name% voice set.~
  END ELSE ACTION_IF (listed = 0) BEGIN
    WARN ~No clip of the %name% voice set fills a one-character slot, so the voice menu would not list it; no voice set.~
  END ELSE BEGIN
    ACTION_IF NOT (~%missing%~ STRING_EQUAL ~~) BEGIN
      WARN ~The game lacks these %name% voice clips, so their slots stay empty:%missing%~
    END
    // The game's own subtitles for the clips.
    ACTION_CLEAR_ARRAY hgc_text
    OUTER_SPRINT tlk ~lang/%EE_LANGUAGE%/dialog.tlk~
    ACTION_IF NOT FILE_EXISTS ~%tlk%~ BEGIN
      OUTER_SPRINT tlk ~dialog.tlk~
    END
    ACTION_IF FILE_EXISTS ~%tlk%~ BEGIN
      COPY - ~%tlk%~ ~override~
        LPF hg_tlk_clip_texts STR_VAR clips = EVAL ~%wanted%~ RET_ARRAY hgc_text = texts END
    END
    // Copy each slot's clip under its file name; one line per slot in the scratch TRA.
    OUTER_SPRINT lines ~~
    OUTER_SET id = 1000
    ACTION_PHP_EACH hgc_suffix AS slot => suffix BEGIN
      OUTER_SPRINT file $hgc_file(~%slot%~)
      ACTION_IF NOT (~%file%~ STRING_EQUAL ~~) BEGIN
        OUTER_SPRINT clip $clip(~%slot%~)
        ACTION_IF (STRING_LENGTH ~%suffix%~ = 1) BEGIN
          COPY_EXISTING ~%clip%.wav~ ~lang/%EE_LANGUAGE%/sounds/%file%.wav~
        END ELSE BEGIN
          COPY_EXISTING ~%clip%.wav~ ~override/%file%.wav~
        END
        ACTION_TO_UPPER clip
        OUTER_SPRINT text ~~
        ACTION_IF VARIABLE_IS_SET EVAL ~hgc_text_%clip%~ BEGIN
          OUTER_SPRINT text $hgc_text(~%clip%~)
        END
        OUTER_SET id += 1
        OUTER_SET $hgc_id(~%slot%~) = id
        OUTER_SPRINT lines ~~~~~%lines%@%id% = ~%text%~ [%file%]%WNL%~~~~~
      END
    END
    <<<<<<<< .../cbpr-inlined/voice.tra
>>>>>>>>
    COPY ~.../cbpr-inlined/voice.tra~ ~%tra%~
      INSERT_BYTES 0 (STRING_LENGTH ~%lines%~)
      WRITE_ASCIIE 0 ~%lines%~
    LOAD_TRA ~%tra%~
    ACTION_PHP_EACH hgc_suffix AS slot => suffix BEGIN
      OUTER_SPRINT file $hgc_file(~%slot%~)
      ACTION_IF NOT (~%file%~ STRING_EQUAL ~~) BEGIN
        OUTER_SET id = $hgc_id(~%slot%~)
        OUTER_SET $hgc_ref(~%slot%~) = RESOLVE_STR_REF ((AT ~%id%~))
        OUTER_SET slots += 1
      END
    END
    LAF cd_add_soundset
      INT_VAR
      cd_action1 = hgc_ref_action1
      cd_action2 = hgc_ref_action2
      cd_action3 = hgc_ref_action3
      cd_action4 = hgc_ref_action4
      cd_action5 = hgc_ref_action5
      cd_action6 = hgc_ref_action6
      cd_action7 = hgc_ref_action7
      cd_action_rare1 = hgc_ref_action_rare1
      cd_action_rare2 = hgc_ref_action_rare2
      cd_attack1 = hgc_ref_attack1
      cd_attack2 = hgc_ref_attack2
      cd_attack3 = hgc_ref_attack3
      cd_attack4 = hgc_ref_attack4
      cd_battlecry1 = hgc_ref_battlecry1
      cd_battlecry2 = hgc_ref_battlecry2
      cd_battlecry3 = hgc_ref_battlecry3
      cd_battlecry4 = hgc_ref_battlecry4
      cd_battlecry5 = hgc_ref_battlecry5
      cd_bored1 = hgc_ref_bored1
      cd_bored2 = hgc_ref_bored2
      cd_breaking_pt = hgc_ref_breaking_pt
      cd_city = hgc_ref_city
      cd_common1 = hgc_ref_common1
      cd_common2 = hgc_ref_common2
      cd_common3 = hgc_ref_common3
      cd_common4 = hgc_ref_common4
      cd_common5 = hgc_ref_common5
      cd_common6 = hgc_ref_common6
      cd_common7 = hgc_ref_common7
      cd_criticalhit = hgc_ref_criticalhit
      cd_criticalmiss = hgc_ref_criticalmiss
      cd_damage1 = hgc_ref_damage1
      cd_day = hgc_ref_day
      cd_disrupted = hgc_ref_disrupted
      cd_dungeon = hgc_ref_dungeon
      cd_dying1 = hgc_ref_dying1
      cd_dying2 = hgc_ref_dying2
      cd_forest = hgc_ref_forest
      cd_gen_death1 = hgc_ref_gen_death1
      cd_gen_death2 = hgc_ref_gen_death2
      cd_happy = hgc_ref_happy
      cd_hurt1 = hgc_ref_hurt1
      cd_hurt2 = hgc_ref_hurt2
      cd_immune = hgc_ref_immune
      cd_inventory = hgc_ref_inventory
      cd_leader1 = hgc_ref_leader1
      cd_leader2 = hgc_ref_leader2
      cd_morale_break1 = hgc_ref_morale_break1
      cd_morale_break2 = hgc_ref_morale_break2
      cd_night = hgc_ref_night
      cd_pickpocket = hgc_ref_pickpocket
      cd_select_rare1 = hgc_ref_select_rare1
      cd_select_rare2 = hgc_ref_select_rare2
      cd_select_rare3 = hgc_ref_select_rare3
      cd_select_rare4 = hgc_ref_select_rare4
      cd_shadows = hgc_ref_shadows
      cd_tired1 = hgc_ref_tired1
      cd_tired2 = hgc_ref_tired2
      cd_trap = hgc_ref_trap
      cd_unhappy_1 = hgc_ref_unhappy_1
      cd_unhappy_2 = hgc_ref_unhappy_2
      cd_select_name = display
      STR_VAR cd_name = EVAL ~%name%~
    END
  END
END

// Whether the current M_cdsnd.lua buffer gives voice `name` a menu name: a line that sets
// filenames_stringrefs['name'] (either quote; commented-out lines do not count).
DEFINE_PATCH_FUNCTION hg_menu_named
  STR_VAR name = ~~
  RET named
BEGIN
  COUNT_REGEXP_INSTANCES CASE_SENSITIVE EVALUATE_REGEXP
    ~^[ %TAB%]*filenames_stringrefs[ %TAB%]*\[[ %TAB%]*['"]%name%['"][ %TAB%]*\]~ n
  SET named = (n > 0)
END

// Upper-case letter (A-Z) for a character code; empty when it is not a letter.
DEFINE_ACTION_FUNCTION hg_upper_letter
  INT_VAR c = 0
  RET letter
BEGIN
  OUTER_SET u = ((c >= 97) AND (c <= 122)) ? (c - 32) : c
  OUTER_SPRINT letter ~~
  ACTION_IF (u >= 65) AND (u <= 90) BEGIN
    OUTER_PATCH ~ABCDEFGHIJKLMNOPQRSTUVWXYZ~ BEGIN
      READ_ASCII (u - 65) letter (1)
    END
  END
END

// The look codes (ITM 0x22: a letter, then a letter or digit) of the game's items whose type
// (ITM 0x1c) is in `melee_types` or `ranged_types` (item types separated by spaces), and how
// the hobgoblin draws the melee ones.
//
// `melee`, `ranged`: key first byte * 256 + second byte, value the code as written.
// `groups`, per melee key: the weapon group the code draws as. A code IESDP names keeps that
// meaning (AX axe, CL club, DD dagger, FL flail, FS S1 S2 S3 SC SS sword, HB halberd, MC mace,
// MS morningstar, QS staff, SL sling, SP spear, WH hammer); any other code takes the group of
// most of its items by item type, a tie going to the earlier group in the order
// sword halberd axe spear staff mace morningstar hammer club flail dagger sling.
// `bodies`, per melee key: the body (0, 1, ...) the code draws on. The engine names a weapon
// layer after its body and the code's first letter in upper case, so two groups that share a
// first letter need two bodies. Per letter the groups in use take bodies 0, 1, ... in the
// order above, except that the groups of `base_codes` come first: body 0's base INI draws
// them and always exists, also when no item uses them.
// `slot_body`, `slot_letter`, `slot_group` (keys 0 to nslots - 1): each body and letter that
// needs a weapon layer, with the group the layer draws. `nbodies`: bodies in use (at least 1).
DEFINE_ACTION_FUNCTION hg_weapon_layout
  STR_VAR melee_types = ~~
          ranged_types = ~~
          base_codes = ~~
  RET nbodies
      nslots
  RET_ARRAY melee
            ranged
            groups
            bodies
            slot_body
            slot_letter
            slot_group
BEGIN
  ACTION_CLEAR_ARRAY melee
  ACTION_CLEAR_ARRAY ranged
  ACTION_CLEAR_ARRAY groups
  ACTION_CLEAR_ARRAY bodies
  ACTION_CLEAR_ARRAY slot_body
  ACTION_CLEAR_ARRAY slot_letter
  ACTION_CLEAR_ARRAY slot_group
  ACTION_DEFINE_ASSOCIATIVE_ARRAY hgw_type_group BEGIN
    16 => dagger   17 => mace   18 => sling   19 => sword   20 => sword   21 => hammer
    22 => morningstar   23 => flail   25 => axe   26 => staff   29 => spear   30 => halberd
    44 => club   57 => sword   69 => sword
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY hgw_known BEGIN
    AX => axe   CL => club   DD => dagger   FL => flail   FS => sword   HB => halberd
    MC => mace   MS => morningstar   QS => staff   S1 => sword   S2 => sword   S3 => sword
    SC => sword   SL => sling   SP => spear   SS => sword   WH => hammer
  END
  // Census: the codes, and per melee code how many of its items each group has.
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
      READ_ASCII 0 sig (4)
      READ_SHORT 0x1c itype
      READ_BYTE 0x22 c1
      READ_BYTE 0x23 c2
      SET ok1 = ((c1 >= 65) AND (c1 <= 90)) OR ((c1 >= 97) AND (c1 <= 122))
      SET ok2 = ok1 AND (((c2 >= 48) AND (c2 <= 57)) OR ((c2 >= 65) AND (c2 <= 90)) OR ((c2 >= 97) AND (c2 <= 122)))
      PATCH_IF (~%sig%~ STRING_EQUAL ~ITM ~) AND ok2 BEGIN
        SET key = c1 * 256 + c2
        READ_ASCII 0x22 code (2)
        PATCH_IF (INDEX (~ %itype% ~ ~ %melee_types% ~) >= 0) BEGIN
          SPRINT $melee(~%key%~) ~%code%~
          PATCH_IF (VARIABLE_IS_SET EVAL ~hgw_type_group_%itype%~) BEGIN
            SPRINT grp $hgw_type_group(~%itype%~)
            PATCH_IF (VARIABLE_IS_SET EVAL ~hgw_n_%key%_%grp%~) BEGIN
              SET $hgw_n(~%key%~ ~%grp%~) = $hgw_n(~%key%~ ~%grp%~) + 1
            END ELSE BEGIN
              SET $hgw_n(~%key%~ ~%grp%~) = 1
            END
          END
        END ELSE PATCH_IF (INDEX (~ %itype% ~ ~ %ranged_types% ~) >= 0) BEGIN
          SPRINT $ranged(~%key%~) ~%code%~
        END
      END
    END
  BUT_ONLY
  // Group of each melee code.
  ACTION_PHP_EACH melee AS key => code BEGIN
    OUTER_SPRINT grp ~~
    ACTION_PHP_EACH hgw_known AS kc => kg BEGIN
      ACTION_IF (~%code%~ STRING_EQUAL ~%kc%~) BEGIN OUTER_SPRINT grp ~%kg%~ END
    END
    ACTION_IF (~%grp%~ STRING_EQUAL ~~) BEGIN
      OUTER_SET best = 0
      ACTION_FOR_EACH g IN sword halberd axe spear staff mace morningstar hammer club flail dagger sling BEGIN
        ACTION_IF (VARIABLE_IS_SET EVAL ~hgw_n_%key%_%g%~) BEGIN
          OUTER_SET n = $hgw_n(~%key%~ ~%g%~)
          ACTION_IF (n > best) BEGIN
            OUTER_SET best = n
            OUTER_SPRINT grp ~%g%~
          END
        END
      END
    END
    ACTION_IF (~%grp%~ STRING_EQUAL ~~) BEGIN OUTER_SPRINT grp ~sword~ END
    OUTER_SPRINT $groups(~%key%~) ~%grp%~
  END
  // Groups in use per first letter, the base codes' groups first.
  ACTION_CLEAR_ARRAY hgw_bases
  OUTER_SET nb = 0
  OUTER_PATCH ~%base_codes%~ BEGIN
    REPLACE_EVALUATE ~\([^ %TAB%]+\)~ BEGIN
      SPRINT $hgw_bases(~%nb%~) ~%MATCH1%~
      SET nb += 1
    END ~%MATCH1%~
  END
  ACTION_CLEAR_ARRAY hgw_letters
  ACTION_PHP_EACH hgw_bases AS i => bc BEGIN
    OUTER_PATCH ~%bc%~ BEGIN
      READ_BYTE 0 c1
      READ_BYTE 1 c2
    END
    OUTER_SET key = c1 * 256 + c2
    ACTION_IF (VARIABLE_IS_SET EVAL ~groups_%key%~) BEGIN
      OUTER_SPRINT grp $groups(~%key%~)
    END ELSE BEGIN
      OUTER_SPRINT grp ~sword~
      ACTION_PHP_EACH hgw_known AS kc => kg BEGIN
        ACTION_IF (~%bc%~ STRING_EQUAL ~%kc%~) BEGIN OUTER_SPRINT grp ~%kg%~ END
      END
    END
    LAF hg_upper_letter INT_VAR c = c1 RET letter END
    ACTION_IF NOT (~%letter%~ STRING_EQUAL ~~) BEGIN
      ACTION_IF NOT (VARIABLE_IS_SET EVAL ~hgw_first_%letter%~) BEGIN
        OUTER_SPRINT $hgw_first(~%letter%~) ~%grp%~
      END
      OUTER_SET $hgw_letters(~%letter%~) = 1
      OUTER_SET $hgw_used(~%letter%~ ~%grp%~) = 1
    END
  END
  ACTION_PHP_EACH melee AS key => code BEGIN
    LAF hg_upper_letter INT_VAR c = key / 256 RET letter END
    OUTER_SPRINT grp $groups(~%key%~)
    OUTER_SET $hgw_letters(~%letter%~) = 1
    OUTER_SET $hgw_used(~%letter%~ ~%grp%~) = 1
  END
  // Bodies per letter, and the weapon layers they need.
  OUTER_SET nbodies = 1
  OUTER_SET nslots = 0
  ACTION_PHP_EACH hgw_letters AS letter => v BEGIN
    OUTER_SET n = 0
    // "base" stands for the group of this letter's base code, if there is one.
    OUTER_SPRINT base ~~
    ACTION_IF (VARIABLE_IS_SET EVAL ~hgw_first_%letter%~) BEGIN
      OUTER_SPRINT base $hgw_first(~%letter%~)
    END
    ACTION_FOR_EACH g IN base sword halberd axe spear staff mace morningstar hammer club flail dagger sling BEGIN
      ACTION_IF (~%g%~ STRING_EQUAL ~base~) BEGIN
        OUTER_SPRINT grp ~%base%~
      END ELSE BEGIN
        OUTER_SPRINT grp ~%g%~
      END
      ACTION_IF NOT (~%grp%~ STRING_EQUAL ~~) BEGIN
        ACTION_IF (VARIABLE_IS_SET EVAL ~hgw_used_%letter%_%grp%~) AND NOT (VARIABLE_IS_SET EVAL ~hgw_body_%letter%_%grp%~) BEGIN
          OUTER_SET $hgw_body(~%letter%~ ~%grp%~) = n
          OUTER_SET $slot_body(~%nslots%~) = n
          OUTER_SPRINT $slot_letter(~%nslots%~) ~%letter%~
          OUTER_SPRINT $slot_group(~%nslots%~) ~%grp%~
          OUTER_SET nslots += 1
          OUTER_SET n += 1
        END
      END
    END
    ACTION_IF (n > nbodies) BEGIN OUTER_SET nbodies = n END
  END
  ACTION_PHP_EACH melee AS key => code BEGIN
    LAF hg_upper_letter INT_VAR c = key / 256 RET letter END
    OUTER_SPRINT grp $groups(~%key%~)
    OUTER_SET $bodies(~%key%~) = $hgw_body(~%letter%~ ~%grp%~)
  END
END

// Two checksums of the frame geometry of the (decompressed) BAM in the buffer, cycle by
// cycle and position by position: each cycle's frame count, then each position's frame
// width, height and centre (or a mark for a lookup entry that names no frame). Frame order,
// compression and pixels do not count, so the same animation from another game gives the
// same sums.
DEFINE_PATCH_FUNCTION hg_bam_geometry_sum
  RET sum1
      sum2
BEGIN
  READ_SHORT 0x08 nfr
  READ_BYTE  0x0a ncy
  READ_LONG  0x0c fo
  READ_LONG  0x14 lo
  SET sum1 = ncy
  SET sum2 = ncy
  FOR (c = 0; c < ncy; ++c) BEGIN
    READ_SHORT (fo + nfr * 12 + c * 4) cnt
    READ_SHORT (fo + nfr * 12 + c * 4 + 2) first
    SET sum1 = (sum1 * 31 + cnt + 1) MODULO 1000003
    SET sum2 = (sum2 * 37 + cnt + 1) MODULO 999983
    FOR (k = 0; k < cnt; ++k) BEGIN
      READ_SHORT (lo + (first + k) * 2) fi
      PATCH_IF (fi >= nfr) BEGIN
        SET sum1 = (sum1 * 31 + 7) MODULO 1000003
        SET sum2 = (sum2 * 37 + 7) MODULO 999983
      END ELSE BEGIN
        READ_SHORT  (fo + fi * 12)     w
        READ_SHORT  (fo + fi * 12 + 2) h
        READ_SSHORT (fo + fi * 12 + 4) cx
        READ_SSHORT (fo + fi * 12 + 6) cy
        SET sum1 = (sum1 * 31 + w + 11) MODULO 1000003
        SET sum1 = (sum1 * 31 + h + 13) MODULO 1000003
        SET sum1 = (sum1 * 31 + cx + 32768) MODULO 1000003
        SET sum1 = (sum1 * 31 + cy + 32768) MODULO 1000003
        SET sum2 = (sum2 * 37 + w + 11) MODULO 999983
        SET sum2 = (sum2 * 37 + h + 13) MODULO 999983
        SET sum2 = (sum2 * 37 + cx + 32768) MODULO 999983
        SET sum2 = (sum2 * 37 + cy + 32768) MODULO 999983
      END
    END
  END
END

// Whether the game's BAM `name` exists and has the frame geometry sums `sum1` and `sum2`
// (hg_bam_geometry_sum).
DEFINE_ACTION_FUNCTION hg_bam_geometry_matches
  INT_VAR sum1 = 0
          sum2 = 0
  STR_VAR name = ~~
  RET ok
BEGIN
  OUTER_SET ok = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%name%.bam~ BEGIN
    COPY_EXISTING - ~%name%.bam~ ~override~
      LPF hg_bam_decompress END
      LPF hg_bam_geometry_sum RET s1 = sum1 s2 = sum2 END
      SET ok = (s1 = sum1) AND (s2 = sum2)
  END
END

// Weapon layer `dst` from the mod's art BAM `art` (a path; BAM or BAMC, written
// decompressed): the art keeps its frames and takes the palette of the game's BAM `palette`,
// whose colour ranges its pixel values refer to; `remap_2h` maps the two-handed attack cycles
// onto the slash cycles, as for the body. Fails when the two BAMs differ in cycle count.
DEFINE_ACTION_FUNCTION hg_copy_weapon_art
  INT_VAR remap_2h = 0
  STR_VAR art = ~~
          palette = ~~
          dst = ~~
BEGIN
  ACTION_CLEAR_ARRAY hga_pal
  COPY_EXISTING - ~%palette%.bam~ ~override~
    LPF hg_bam_decompress END
    READ_BYTE 0x0a hga_ncy
    READ_LONG 0x10 po
    FOR (i = 0; i < 256; ++i) BEGIN
      READ_LONG (po + i * 4) v
      SET $hga_pal(~%i%~) = v
    END
  COPY ~%art%~ ~override/%dst%.bam~
    LPF hg_bam_decompress END
    READ_BYTE 0x0a ncy
    PATCH_IF (ncy != hga_ncy) BEGIN
      PATCH_FAIL ~%art% has %ncy% cycles, %palette%.bam %hga_ncy%~
    END
    READ_LONG 0x10 po
    FOR (i = 0; i < 256; ++i) BEGIN
      WRITE_LONG (po + i * 4) $hga_pal(~%i%~)
    END
    PATCH_IF remap_2h BEGIN
      LPF hg_bam_copy_cycles INT_VAR from = 0 to = 16 count = 8 END
    END
END

// Whether no BAM of the game (key or override) has a name that starts with `prefix`.
DEFINE_ACTION_FUNCTION hg_bam_prefix_free
  STR_VAR prefix = ~~
  RET free
BEGIN
  OUTER_SET free = 1
  COPY_EXISTING_REGEXP GLOB ~^%prefix%.*\.bam$~ ~override~
    SET free = 0
  BUT_ONLY IF_EXISTS   // no match is no error
END

// A row `label` for race `id` in the campaign race table in the buffer: the strings
// `name_ref`, `desc_ref` (-1: not offered in character creation), `upper_ref` and `bio_ref`
// go into the columns NAME, DESCSTR, UPPERCASE and BIOGRAPHY wherever they are, `id` into
// ID, and any other column gets the table's default value. The games fill NAME with the
// lower-case name the race list shows ("half-orc") and UPPERCASE with the capitalized one the
// record screen shows ("Half-Orc"); the record screen finds a race's row by its ID. Character creation lists the
// races whose row has a description, keyed by row number, so the row goes in front of the
// first row without one: behind such a row it would leave a gap in the list, where the race
// menu stops (lab run 14). At the end when every row has a description. Nothing (`added`
// 0) when the table has a row `label` or a row for race `id` already, or no ID column.
DEFINE_PATCH_FUNCTION hg_race_row
  INT_VAR id = 0
          name_ref = 0 - 1
          desc_ref = 0 - 1
          upper_ref = 0 - 1
          bio_ref = 0 - 1
  STR_VAR label = ~~
  RET added
BEGIN
  SET added = 0
  LPF hg_2da_layout RET ncols drow nrows hrow END
  LPF hg_2da_column STR_VAR name = ~ID~ RET cid = column END
  LPF hg_2da_column STR_VAR name = ~DESCSTR~ RET cdesc = column END
  READ_2DA_ENTRY 1 0 1 default
  SET taken = (cid = 0)
  SET at = drow + nrows
  FOR (r = drow + nrows - 1; r >= drow; r = r - 1) BEGIN
    READ_2DA_ENTRY r 0 ncols lbl
    READ_2DA_ENTRY r cid ncols rid
    PATCH_IF (~%lbl%~ STRING_EQUAL_CASE ~%label%~) OR ((IS_AN_INT rid) AND (rid = id)) BEGIN
      SET taken = 1
    END
    PATCH_IF (cdesc > 0) BEGIN
      READ_2DA_ENTRY r cdesc ncols d
      PATCH_IF (~%d%~ STRING_EQUAL ~-1~) BEGIN SET at = r END
    END
  END
  PATCH_IF NOT taken BEGIN
    SPRINT row ~%label%~
    FOR (c = 0; c < ncols - 1; ++c) BEGIN
      READ_2DA_ENTRY hrow c (ncols - 1) head
      TO_UPPER head
      PATCH_IF (~%head%~ STRING_EQUAL ~ID~) BEGIN
        SPRINT v ~%id%~
      END ELSE PATCH_IF (~%head%~ STRING_EQUAL ~NAME~) BEGIN
        SPRINT v ~%name_ref%~
      END ELSE PATCH_IF (~%head%~ STRING_EQUAL ~DESCSTR~) BEGIN
        SPRINT v ~%desc_ref%~
      END ELSE PATCH_IF (~%head%~ STRING_EQUAL ~UPPERCASE~) BEGIN
        SPRINT v ~%upper_ref%~
      END ELSE PATCH_IF (~%head%~ STRING_EQUAL ~BIOGRAPHY~) BEGIN
        SPRINT v ~%bio_ref%~
      END ELSE BEGIN
        SPRINT v ~%default%~
      END
      SPRINT row ~%row% %v%~
    END
    INSERT_2DA_ROW at ncols ~%row%~
    SET added = 1
  END
END

// The entry in the column `value_col` of the first row whose column `key_col` holds `key`
// (letter case ignored), in the 2DA table in the buffer; `found` 0 and `value` empty when no
// row matches or a column is missing.
DEFINE_PATCH_FUNCTION hg_2da_lookup
  STR_VAR key_col = ~~
          key = ~~
          value_col = ~~
  RET found
      value
BEGIN
  SET found = 0
  SPRINT value ~~
  LPF hg_2da_column STR_VAR name = EVAL ~%key_col%~ RET kc = column END
  LPF hg_2da_column STR_VAR name = EVAL ~%value_col%~ RET vc = column END
  PATCH_IF (kc > 0) AND (vc > 0) BEGIN
    LPF hg_2da_layout RET ncols drow nrows END
    FOR (r = drow; (r < drow + nrows) AND NOT found; ++r) BEGIN
      READ_2DA_ENTRY r kc ncols k
      PATCH_IF (~%k%~ STRING_EQUAL_CASE ~%key%~) BEGIN
        READ_2DA_ENTRY r vc ncols value
        SET found = 1
      END
    END
  END
END

// Race `race` in character creation, as row `label` (hg_race_row) of every race table the
// campaigns use (CAMPAIGN.2DA column RACETEXT, and RACETEXT.2DA itself) that the game has: the
// strings `name_ref`, `desc_ref` and `upper_ref`, and the biography `bio_ref` in each table where
// the human (race 1) has one, else -1. `found`: how many of these tables the game has; `tables`:
// how many got the row (none where the table has a row of that race or label already, or no ID
// column).
DEFINE_ACTION_FUNCTION hg_offer_race
  INT_VAR race = 0
          name_ref = 0 - 1
          desc_ref = 0 - 1
          upper_ref = 0 - 1
          bio_ref = 0 - 1
  STR_VAR label = ~~
  RET tables
      found
BEGIN
  ACTION_CLEAR_ARRAY hgo_tables
  ACTION_CLEAR_ARRAY hgo_campaign
  OUTER_SPRINT $hgo_tables(~RACETEXT~) ~RACETEXT~
  ACTION_IF FILE_EXISTS_IN_GAME ~campaign.2da~ BEGIN
    COPY_EXISTING - ~campaign.2da~ ~override~
      LPF hg_campaign_column STR_VAR name = ~RACETEXT~ RET_ARRAY hgo_campaign = values END
  END
  ACTION_PHP_EACH hgo_campaign AS t => v BEGIN
    OUTER_SPRINT $hgo_tables(~%t%~) ~%t%~
  END
  OUTER_SET tables = 0
  OUTER_SET found = 0
  ACTION_PHP_EACH hgo_tables AS t => v BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%t%.2da~ BEGIN
      OUTER_SET found += 1
      COPY_EXISTING ~%t%.2da~ ~override~
        SET row_bio = 0 - 1
        LPF hg_2da_lookup STR_VAR key_col = ~ID~ key = ~1~ value_col = ~BIOGRAPHY~ RET human = found hbio = value END
        PATCH_IF human AND (IS_AN_INT ~%hbio%~) BEGIN
          PATCH_IF (hbio >= 0) BEGIN
            SET row_bio = bio_ref
          END
        END
        LPF hg_race_row INT_VAR id = race name_ref desc_ref upper_ref bio_ref = row_bio STR_VAR label RET added END
        SET tables += added
      BUT_ONLY
    END
  END
END
