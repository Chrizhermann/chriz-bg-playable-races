// Helper functions for the hobgoblin protagonist prototype.

// Four-digit upper-case hex text of a non-negative integer (animation slot -> INI name).
DEFINE_ACTION_FUNCTION hg_hex4
  INT_VAR value = 0
  RET hex
BEGIN
  OUTER_SPRINT hex ~~
  OUTER_SET rest = value
  OUTER_FOR (i = 0; i < 4; ++i) BEGIN
    OUTER_SET d = rest MODULO 16
    OUTER_SET rest = rest / 16
    OUTER_PATCH ~0123456789ABCDEF~ BEGIN
      READ_ASCII d digit (1)
    END
    OUTER_SPRINT hex ~%digit%%hex%~
  END
  ACTION_IF rest != 0 BEGIN
    FAIL ~hg_hex4: %value% does not fit in four hex digits~
  END
END

// First animation slot in [slot_min, slot_max) that has neither an ANIMATE.IDS symbol
// nor an INI resource. Returns -1 when the range is full.
DEFINE_ACTION_FUNCTION hg_find_free_anim_slot
  INT_VAR slot_min = 0
          slot_max = 0
  RET slot
BEGIN
  ACTION_IF slot_max <= slot_min BEGIN
    OUTER_SET slot_max = (slot_min BAND 0xF000) + 0x1000
  END
  OUTER_SET slot = 0 - 1
  OUTER_FOR (idx = slot_min; idx < slot_max; ++idx) BEGIN
    OUTER_PATCH ~~ BEGIN
      LOOKUP_IDS_SYMBOL_OF_INT name ~animate~ idx
    END
    ACTION_IF (~%name%~ STRING_EQUAL ~%idx%~) BEGIN
      LAF hg_hex4 INT_VAR value = idx RET hex END
      ACTION_IF NOT FILE_EXISTS_IN_GAME ~%hex%.ini~ BEGIN
        OUTER_SET slot = idx
        OUTER_SET idx = slot_max
      END
    END
  END
END

// Turn a BAMC (zlib) buffer into a plain BAM V1 buffer; fail on anything else.
DEFINE_PATCH_FUNCTION hg_bam_decompress BEGIN
  READ_ASCII 0 sig (8)
  PATCH_IF (~%sig%~ STRING_EQUAL ~BAMCV1  ~) BEGIN
    READ_LONG 8 ulen
    DECOMPRESS_REPLACE_FILE 12 (BUFFER_LENGTH - 12) ulen
    READ_ASCII 0 sig (8)
  END
  PATCH_IF NOT (~%sig%~ STRING_EQUAL ~BAM V1  ~) BEGIN
    PATCH_FAIL ~%SOURCE_FILE% is not a BAM V1/BAMC file (signature "%sig%")~
  END
END

// Point cycles [to, to+count) at the same frames as cycles [from, from+count).
DEFINE_PATCH_FUNCTION hg_bam_copy_cycles
  INT_VAR from = 0
          to = 16
          count = 8
BEGIN
  READ_SHORT 0x08 nfr
  READ_BYTE  0x0a ncy
  READ_LONG  0x0c fo
  PATCH_IF ((from + count > ncy) OR (to + count > ncy)) BEGIN
    PATCH_FAIL ~%SOURCE_FILE% has %ncy% cycles; cannot map cycles %from%+%count% to %to%~
  END
  FOR (i = 0; i < count; ++i) BEGIN
    READ_LONG (fo + nfr * 12 + (from + i) * 4) entry
    WRITE_LONG (fo + nfr * 12 + (to + i) * 4) entry
  END
END

// Copy one game BAM to a new name, decompressed, optionally mapping the two-handed
// attack cycles (16-23) onto the one-handed slash cycles (0-7).
DEFINE_ACTION_FUNCTION hg_copy_bam
  INT_VAR remap_2h = 0
  STR_VAR src = ~~
          dst = ~~
BEGIN
  COPY_EXISTING ~%src%.bam~ ~override/%dst%.bam~
    LPF hg_bam_decompress END
    PATCH_IF remap_2h BEGIN
      LPF hg_bam_copy_cycles INT_VAR from = 0 to = 16 count = 8 END
    END
END

// Write one EFF V2.0 file applying opcode 53 (animation change) while equipped.
// kind 2 mirrors the engine's own item-driven animation switches (SoD M'Khiin).
// The parent resource must name the EFF itself, as in CDMK25.EFF: opcode 318/206
// immunities match the applied effect's parent resource, so without it the item's
// op318 guard never blocks and every wielder changes sprite (lab-verified).
DEFINE_ACTION_FUNCTION hg_make_anim_eff
  INT_VAR anim = 0
          kind = 2
  STR_VAR name = ~~
BEGIN
  LAF hg_make_eq_eff INT_VAR opcode = 53 parameter1 = anim parameter2 = kind STR_VAR name END
END

// Write one EFF V2.0 file holding a single self-targeted effect (default: while equipped)
// whose parent resource is the EFF itself (see hg_make_anim_eff for why the parent matters).
DEFINE_ACTION_FUNCTION hg_make_eq_eff
  INT_VAR opcode = 0
          parameter1 = 0
          parameter2 = 0
          timing = 2
          duration = 0
  STR_VAR name = ~~
          resource = ~~
BEGIN
  OUTER_SPRINT parent ~%name%~
  ACTION_TO_UPPER ~parent~
  OUTER_SET len = STRING_LENGTH ~%name%~
  ACTION_IF (len < 1) OR (len > 8) BEGIN
    FAIL ~hg_make_eq_eff: "%name%" is not a valid resource name~
  END
  CREATE ~EFF~ ~%name%~
    WRITE_LONG 0x10 opcode
    WRITE_LONG 0x14 1       // target: self
    WRITE_LONG 0x1c parameter1
    WRITE_LONG 0x20 parameter2
    WRITE_SHORT 0x24 timing
    WRITE_LONG 0x28 duration
    WRITE_SHORT 0x2c 100    // probability 1
    WRITE_SHORT 0x2e 0      // probability 2
    PATCH_IF NOT (~%resource%~ STRING_EQUAL ~~) BEGIN
      WRITE_ASCIIE 0x30 ~%resource%~ #8
    END
    WRITE_LONG 0x90 1       // parent resource type: spell
    WRITE_ASCIIE 0x94 ~%parent%~ #8   // parent resource: this EFF
END

// Give the current ITM one PC-only switch: an equipped effect applies the EFF while the item
// is equipped, op318 in front of it shields every creature without the marker spell state.
// Default op177 runs the EFF's effect inside itself every tick (fine for opcode 53, but colour
// changes made that way never show); op272 (apply_p1 = 1, apply_p2 = 0: once per second)
// attaches the EFF to the creature instead. op318 does not stop op272 (lab run 5), so an
// op272 EFF has to check the creature itself and is added with guard = 0.
// Skips an item that already carries this switch.
DEFINE_PATCH_FUNCTION hg_add_switch
  INT_VAR splstate = 0
          splprot_row = 0
          guard = 1
          apply_opcode = 177
          apply_p1 = 0
          apply_p2 = 2
  STR_VAR eff = ~~
BEGIN
  READ_LONG  0x6a fx_off
  READ_SHORT 0x6e fx_idx
  READ_SHORT 0x70 fx_n
  SET done = 0
  FOR (i = 0; i < fx_n; ++i) BEGIN
    READ_SHORT (fx_off + (fx_idx + i) * 0x30) op
    READ_ASCII (fx_off + (fx_idx + i) * 0x30 + 0x14) res (8) NULL
    PATCH_IF (op = apply_opcode) AND (~%res%~ STRING_EQUAL_CASE ~%eff%~) BEGIN SET done = 1 END
  END
  PATCH_IF NOT done BEGIN
    // ADD_ITEM_EQEFFECT inserts at the top of the list: add the switch first so the
    // guard ends up in front of it, as in the installed M'Khiin weapons.
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = apply_opcode target = 1 timing = 2 parameter1 = apply_p1
      parameter2 = apply_p2 STR_VAR resource = EVAL ~%eff%~ END
    PATCH_IF guard BEGIN
      LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 318 target = 1 timing = 2 parameter1 = splstate
        parameter2 = splprot_row STR_VAR resource = EVAL ~%eff%~ END
    END
  END
END

// 0-based SPLPROT.2DA data row for (stat, value, relation), the first match; appends a row
// labelled `label` when the table has none. Rows with a non-numeric cell never match.
DEFINE_ACTION_FUNCTION hg_splprot_row
  INT_VAR stat = 0
          value = 0
          relation = 0
  STR_VAR label = ~~
  RET row
BEGIN
  OUTER_SET row = 0 - 1
  COPY_EXISTING ~splprot.2da~ ~override~
    COUNT_2DA_ROWS 4 nrows
    FOR (r = 0; r < nrows; ++r) BEGIN
      READ_2DA_ENTRY r 1 4 st
      READ_2DA_ENTRY r 2 4 va
      READ_2DA_ENTRY r 3 4 re
      PATCH_IF (row < 0) AND (IS_AN_INT st) AND (IS_AN_INT va) AND (IS_AN_INT re) BEGIN
        PATCH_IF (st = stat) AND (va = value) AND (re = relation) BEGIN
          SET row = r
        END
      END
    END
    PATCH_IF (row < 0) BEGIN
      INSERT_2DA_ROW nrows 4 ~%label% %stat% %value% %relation%~
      SET row = nrows
    END
  BUT_ONLY
END

// Turn the buffer of a fresh CREATE ~SPL~ into a nameless innate level-1 spell with one
// ability (standard, innate, targets the caster, no projectile) and no effects yet.
DEFINE_PATCH_FUNCTION hg_spl_init BEGIN
  PATCH_IF (BUFFER_LENGTH != 0x72) BEGIN PATCH_FAIL ~hg_spl_init: unexpected new SPL size~ END
  WRITE_LONG 0x08 (0 - 1)     // no names or descriptions
  WRITE_LONG 0x0c (0 - 1)
  WRITE_LONG 0x50 (0 - 1)
  WRITE_LONG 0x54 (0 - 1)
  WRITE_SHORT 0x1c 4          // innate
  WRITE_LONG 0x34 1           // level 1
  INSERT_BYTES 0x72 0x28      // one ability header
  WRITE_LONG  0x64 0x72       // abilities offset
  WRITE_SHORT 0x68 1          // abilities count
  WRITE_LONG  0x6a 0x9a       // effects offset
  WRITE_SHORT 0x6e 0          // casting effects index
  WRITE_SHORT 0x70 0          // casting effects count
  WRITE_BYTE  0x72 1          // ability form: standard
  WRITE_SHORT 0x74 4          // location: innate
  WRITE_BYTE  0x7e 5          // target: caster
  WRITE_SHORT 0x82 1          // level
  WRITE_SHORT 0x98 1          // projectile: none
END

// Innate spell, nameless, that gives its target the metal and armor colour ranges `metal`
// and the major range `cloak` for `duration` seconds. Meant for opcode 326, which applies it
// to its own target; its effects use target 2 like the game's own op326 spells (BDBOW04).
DEFINE_ACTION_FUNCTION hg_make_colour_spl
  INT_VAR metal = 0
          cloak = 0
          duration = 3
  STR_VAR name = ~~
BEGIN
  CREATE ~SPL~ ~%name%~
    LPF hg_spl_init END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = metal parameter2 = 0 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = metal parameter2 = 5 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 7 target = 2 timing = 0 duration parameter1 = cloak parameter2 = 2 END
END

// Private animation INI derived from the installed hobgoblin INI: given walking speed,
// body resref and the two weapon look codes it draws; no animation-level selection or
// battle-cry voice (the PC's soundset owns those).
DEFINE_ACTION_FUNCTION hg_make_ini
  INT_VAR slot = 0
          move = 9
  STR_VAR body = ~~
          w1 = ~~
          w2 = ~~
BEGIN
  LAF hg_hex4 INT_VAR value = slot RET hex END
  COPY_EXISTING ~8100.ini~ ~override/%hex%.ini~
    COUNT_REGEXP_INSTANCES ~^resref[ %TAB%]*=~ n_resref
    PATCH_IF (n_resref != 1) BEGIN
      PATCH_FAIL ~8100.ini: expected exactly one "resref=" line, found %n_resref%~
    END
    REPLACE_TEXTUALLY ~^\(move_scale[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%move%~
    REPLACE_TEXTUALLY ~^\(resref[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%body%~
    COUNT_REGEXP_INSTANCES ~^resref_weapon1[ %TAB%]*=~ n_w1
    PATCH_IF (n_w1 = 0) BEGIN
      REPLACE_TEXTUALLY ~^\(resref[ %TAB%]*=[^%MNL%%LNL%]*\)~ ~\1%WNL%resref_weapon1=%w1%%WNL%resref_weapon2=%w2%~
    END ELSE BEGIN
      REPLACE_TEXTUALLY ~^\(resref_weapon1[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%w1%~
      REPLACE_TEXTUALLY ~^\(resref_weapon2[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1%w2%~
    END
    REPLACE_TEXTUALLY ~^\(selection[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1~
    REPLACE_TEXTUALLY ~^\(battle_cry[ %TAB%]*=\)[^%MNL%%LNL%]*~ ~\1~
END

// Inventory figure from the current (decompressed) creature BAM: frame 0 of `cycle`, scaled
// up `scale` times, as a BAM of two frames (the figure and a 1x1 blank) with one cycle
// (0, 0, 1) and the source palette. The centre (cx, cy) places it on the paperdoll; the
// defaults are the values the lab prototype showed correctly. The blank pixel is the
// palette's transparent colour (as the engine picks it: the first RGB(0,255,0) entry, else
// entry 0), and the header keeps the source's RLE index, so a replaced creature BAM that
// uses other indices for them still gives a clean figure.
DEFINE_PATCH_FUNCTION hg_bam_inv_figure
  INT_VAR cycle = 16
          scale = 2
          cx = 0 - 4
          cy = 0 - 16
BEGIN
  READ_SHORT 0x08 nfr
  READ_BYTE  0x0a ncy
  READ_BYTE  0x0b rle
  READ_LONG  0x0c fo
  READ_LONG  0x10 po
  READ_LONG  0x14 lo
  PATCH_IF (cycle >= ncy) BEGIN PATCH_FAIL ~%SOURCE_FILE% has no cycle %cycle%~ END
  READ_SHORT (fo + nfr * 12 + cycle * 4) ccount
  READ_SHORT (fo + nfr * 12 + cycle * 4 + 2) cfirst
  PATCH_IF (ccount < 1) BEGIN PATCH_FAIL ~%SOURCE_FILE%: cycle %cycle% is empty~ END
  READ_SHORT (lo + cfirst * 2) fi
  PATCH_IF (fi >= nfr) BEGIN PATCH_FAIL ~%SOURCE_FILE%: cycle %cycle% names frame %fi% of %nfr%~ END
  READ_SHORT (fo + fi * 12)     w
  READ_SHORT (fo + fi * 12 + 2) h
  READ_LONG  (fo + fi * 12 + 8) doff
  SET raw = ((doff BAND 0x80000000) != 0)
  SET doff = (doff BAND 0x7FFFFFFF)
  SET old = BUFFER_LENGTH
  // Decode the frame (RLE: the compressed index is followed by a count of extra copies)
  // into a scratch area behind the original data.
  SET dec = old
  INSERT_BYTES dec (w * h)
  SET i = 0
  SET p = doff
  WHILE (i < w * h) BEGIN
    PATCH_IF (p >= old) BEGIN PATCH_FAIL ~%SOURCE_FILE%: frame %fi% data ends early~ END
    READ_BYTE p b
    SET p += 1
    PATCH_IF (NOT raw) AND (b = rle) BEGIN
      PATCH_IF (p >= old) BEGIN PATCH_FAIL ~%SOURCE_FILE%: frame %fi% data ends early~ END
      READ_BYTE p run
      SET p += 1
      FOR (k = 0; (k <= run) AND (i < w * h); ++k) BEGIN
        WRITE_BYTE (dec + i) rle
        SET i += 1
      END
    END ELSE BEGIN
      WRITE_BYTE (dec + i) b
      SET i += 1
    END
  END
  // Build the figure BAM behind the scratch area, then drop everything in front of it.
  SET bw = w * scale
  SET bh = h * scale
  SET nb = dec + w * h
  SET b_fo = 0x18                 // two frame entries
  SET b_co = b_fo + 2 * 12        // one cycle entry
  SET b_po = b_co + 4             // palette
  SET b_lo = b_po + 1024          // lookup table
  SET b_do = b_lo + 3 * 2         // figure pixels, then the blank frame's pixel
  INSERT_BYTES nb (b_do + bw * bh + 1)
  WRITE_ASCII nb ~BAM V1  ~
  WRITE_SHORT (nb + 0x08) 2
  WRITE_BYTE  (nb + 0x0a) 1
  WRITE_BYTE  (nb + 0x0b) rle
  WRITE_LONG  (nb + 0x0c) b_fo
  WRITE_LONG  (nb + 0x10) b_po
  WRITE_LONG  (nb + 0x14) b_lo
  WRITE_SHORT (nb + b_fo)      bw
  WRITE_SHORT (nb + b_fo + 2)  bh
  WRITE_SHORT (nb + b_fo + 4)  cx
  WRITE_SHORT (nb + b_fo + 6)  cy
  WRITE_LONG  (nb + b_fo + 8)  (0x80000000 BOR b_do)
  WRITE_SHORT (nb + b_fo + 12) 1
  WRITE_SHORT (nb + b_fo + 14) 1
  WRITE_LONG  (nb + b_fo + 20) (0x80000000 BOR (b_do + bw * bh))
  WRITE_SHORT (nb + b_co)      3
  WRITE_SHORT (nb + b_co + 2)  0
  SET tr = 0 - 1
  FOR (c = 0; c < 256; ++c) BEGIN
    READ_LONG (po + c * 4) col
    WRITE_LONG (nb + b_po + c * 4) col
    PATCH_IF (tr < 0) AND ((col BAND 0xFFFFFF) = 0x00FF00) BEGIN SET tr = c END
  END
  WRITE_BYTE (nb + b_do + bw * bh) ((tr < 0) ? 0 : tr)
  WRITE_SHORT (nb + b_lo + 4) 1
  FOR (y = 0; y < bh; ++y) BEGIN
    FOR (x = 0; x < bw; ++x) BEGIN
      READ_BYTE (dec + (y / scale) * w + (x / scale)) v
      WRITE_BYTE (nb + b_do + y * bw + x) v
    END
  END
  DELETE_BYTES 0 nb
END

// Sound resref of `strref` in the current TLK V1 buffer; empty when it has none, or when
// the buffer is no TLK V1 or the strref lies outside it.
DEFINE_PATCH_FUNCTION hg_tlk_sound
  INT_VAR strref = 0
  RET sound
BEGIN
  SPRINT sound ~~
  READ_ASCII 0 sig (8)
  PATCH_IF (~%sig%~ STRING_EQUAL ~TLK V1  ~) BEGIN
    READ_LONG 0x0a count
    PATCH_IF (strref >= 0) AND (strref < count) BEGIN
      READ_ASCII (0x12 + strref * 0x1a + 2) sound (8) NULL
    END
  END
END

// Layout of the 2DA table in the buffer, for READ_2DA_ENTRY: `ncols` entries in a data row
// (row label included), the data rows `drow` to `drow + nrows - 1` read with `ncols`, and
// the column-name line as row `hrow` read with `ncols - 1`. READ_2DA_ENTRY and
// COUNT_2DA_ROWS count only lines with at least that many entries, so with one or two
// columns the signature line "2DA V1.0" (two entries) and the default value line (one)
// count as well, in front.
DEFINE_PATCH_FUNCTION hg_2da_layout
  RET ncols drow nrows hrow
BEGIN
  COUNT_2DA_COLS ncols
  SET hrow = ((ncols - 1 <= 2) ? 1 : 0) + ((ncols - 1 <= 1) ? 1 : 0)
  SET drow = (ncols <= 2) ? 1 : 0
  SET nrows = 0
  PATCH_IF (ncols >= 2) BEGIN
    COUNT_2DA_ROWS ncols n
    SET nrows = n - drow
  END
END

// Data-row index of the column `name` in the 2DA table in the buffer (1 = the first column
// after the row label), 0 when there is none.
DEFINE_PATCH_FUNCTION hg_2da_column
  STR_VAR name = ~~
  RET column
BEGIN
  LPF hg_2da_layout RET ncols hrow END
  SET column = 0
  FOR (c = 0; (c < ncols - 1) AND (column = 0); ++c) BEGIN
    READ_2DA_ENTRY hrow c (ncols - 1) head
    PATCH_IF (~%head%~ STRING_EQUAL_CASE ~%name%~) BEGIN SET column = c + 1 END
  END
END

// The world scripts named in the current CAMPAIGN.2DA buffer (column WORLDSCRIPT), upper
// case, as the keys of `scripts`; empty without such a column.
DEFINE_PATCH_FUNCTION hg_campaign_world_scripts
  RET_ARRAY scripts
BEGIN
  CLEAR_ARRAY scripts
  LPF hg_2da_column STR_VAR name = ~WORLDSCRIPT~ RET wcol = column END
  PATCH_IF (wcol > 0) BEGIN
    LPF hg_2da_layout RET ncols drow nrows END
    FOR (r = drow; r < drow + nrows; ++r) BEGIN
      READ_2DA_ENTRY r wcol ncols ws
      TO_UPPER ~ws~
      PATCH_IF NOT (~%ws%~ STRING_EQUAL ~*~) BEGIN
        SPRINT $scripts(~%ws%~) ~%ws%~
      END
    END
  END
END

// Does the current CHARSND.2DA buffer have the layout the engine expects (exactly 99 rows,
// labelled 1-99 in order)? Another layout would put sounds into the wrong slots. `present`
// tells whether it already has a column `name`.
DEFINE_PATCH_FUNCTION hg_charsnd_check
  STR_VAR name = ~~
  RET ok
      present
BEGIN
  LPF hg_2da_layout RET ncols drow nrows END
  SET ok = (nrows = 99)
  FOR (r = 0; ok AND (r < nrows); ++r) BEGIN
    READ_2DA_ENTRY (drow + r) 0 ncols label
    SET ok = (IS_AN_INT label) AND (label = r + 1)
  END
  LPF hg_2da_column STR_VAR name RET column END
  SET present = (column > 0)
END

// Inventory figure resource `dst` from frame 0 of `cycle` of the game's BAM `src`.
DEFINE_ACTION_FUNCTION hg_make_inv_bam
  INT_VAR cycle = 16
  STR_VAR src = ~~
          dst = ~~
BEGIN
  COPY_EXISTING ~%src%.bam~ ~override/%dst%.bam~
    LPF hg_bam_decompress END
    LPF hg_bam_inv_figure INT_VAR cycle END
END

// Put the script `baf` (compiled with EVALUATE_BUFFER) on top of every world script the
// game's campaigns run (CAMPAIGN.2DA), each once; BALDUR.BCS when the table names none.
// Returns how many scripts were extended.
DEFINE_ACTION_FUNCTION hg_extend_world_scripts
  STR_VAR baf = ~~
  RET count
BEGIN
  ACTION_CLEAR_ARRAY hgw_scripts
  ACTION_IF FILE_EXISTS_IN_GAME ~campaign.2da~ BEGIN
    COPY_EXISTING - ~campaign.2da~ ~override~
      LPF hg_campaign_world_scripts RET_ARRAY hgw_scripts = scripts END
  END
  OUTER_SET count = 0
  ACTION_PHP_EACH hgw_scripts AS ws => v BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%ws%.bcs~ BEGIN
      EXTEND_TOP ~%ws%.bcs~ ~%baf%~ EVALUATE_BUFFER
      OUTER_SET count += 1
    END
  END
  ACTION_IF (count = 0) BEGIN
    EXTEND_TOP ~baldur.bcs~ ~%baf%~ EVALUATE_BUFFER
    OUTER_SET count = 1
  END
END

// Player voice set `name` (1-6 characters) from the creatures that use `animation`: for
// each sound slot the string most of them use. Rows 1-34 only: their meaning matches the
// creature sound slots and is the same in BG:EE and BG2:EE (rows 35-38 differ).
// It is laid out like an EE Soundset Tool voice. The voice menu lists the voices whose
// files lie in lang/<language>/sounds, named the classic way: voice name plus a character
// for the sound slot. So each chosen line's sound is copied there under that name
// (two-character slots go to override, where they do not show up as voices of their own),
// and the line is resolved again with that sound and a leading "[TAG]" removed (an
// identical existing string is reused). The strings then fill a CHARSND.2DA column and the
// menu shows strref `display`. `tra` is a scratch file in the mod folder. Returns the
// filled slots, 0 when the creatures have no voice, or when CHARSND.2DA has an unexpected
// layout or the name is taken: a CHARSND.2DA column or M_cdsnd.lua menu name `name`, or a
// sound file the voice would write (warned; then nothing is changed).
DEFINE_ACTION_FUNCTION hg_creature_voice
  INT_VAR animation = 0
          display = 0 - 1
  STR_VAR name = ~~
          tra = ~~
  RET slots
BEGIN
  ACTION_IF (STRING_LENGTH ~%name%~ < 1) OR (STRING_LENGTH ~%name%~ > 6) BEGIN
    FAIL ~hg_creature_voice: voice name "%name%" needs 1-6 characters (file names add up to two).~
  END
  OUTER_SET slots = 0
  OUTER_SET ok = 0
  OUTER_SET present = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~charsnd.2da~ BEGIN
    COPY_EXISTING - ~charsnd.2da~ ~override~
      LPF hg_charsnd_check STR_VAR name RET ok present END
  END
  OUTER_SET named = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~m_cdsnd.lua~ BEGIN
    COPY_EXISTING - ~m_cdsnd.lua~ ~override~
      LPF hg_menu_named STR_VAR name RET named END
  END
  ACTION_IF NOT ok BEGIN
    WARN ~CHARSND.2DA is missing or lacks the 99 numbered rows the engine expects; no %name% voice set.~
  END ELSE ACTION_IF present OR named BEGIN
    WARN ~The voice name %name% is taken (CHARSND.2DA column or M_cdsnd.lua menu name); no voice set.~
  END ELSE BEGIN
    LAF hg_creature_voice_build INT_VAR animation display STR_VAR name tra RET slots END
  END
END

// The body of hg_creature_voice, once CHARSND.2DA is known to take the voice set.
DEFINE_ACTION_FUNCTION hg_creature_voice_build
  INT_VAR animation = 0
          display = 0 - 1
  STR_VAR name = ~~
          tra = ~~
  RET slots
BEGIN
  OUTER_SET slots = 0
  OUTER_FOR (r = 1; r < 35; ++r) BEGIN
    OUTER_SET $hgv_n(~%r%~) = 0
    OUTER_SET $hgv_ref(~%r%~) = 0 - 1
    OUTER_SPRINT $hgv_snd(~%r%~) ~~
    OUTER_SET $hgv_col(~%r%~) = 0 - 1
  END
  // Vote per slot; ties go to the lower strref.
  COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x234) BEGIN
      READ_ASCII 0 sig (8)
      READ_SHORT 0x28 anim
      PATCH_IF (~%sig%~ STRING_EQUAL ~CRE V1.0~) AND (anim = animation) BEGIN
        FOR (r = 1; r < 35; ++r) BEGIN
          READ_SLONG (0xa4 + r * 4) ref
          PATCH_IF (ref > 0) BEGIN
            PATCH_IF VARIABLE_IS_SET EVAL ~hgv_vote_%r%_%ref%~ BEGIN
              SET $hgv_vote(~%r%~ ~%ref%~) = $hgv_vote(~%r%~ ~%ref%~) + 1
            END ELSE BEGIN
              SET $hgv_vote(~%r%~ ~%ref%~) = 1
            END
            SET n = $hgv_vote(~%r%~ ~%ref%~)
            PATCH_IF (n > $hgv_n(~%r%~)) OR ((n = $hgv_n(~%r%~)) AND (ref < $hgv_ref(~%r%~))) BEGIN
              SET $hgv_n(~%r%~) = n
              SET $hgv_ref(~%r%~) = ref
            END
          END
        END
      END
    END
  BUT_ONLY
  // Sounds of the chosen strings, read from the game's string table.
  OUTER_SPRINT tlk ~lang/%EE_LANGUAGE%/dialog.tlk~
  ACTION_IF NOT FILE_EXISTS ~%tlk%~ BEGIN OUTER_SPRINT tlk ~dialog.tlk~ END
  ACTION_IF FILE_EXISTS ~%tlk%~ BEGIN
    COPY - ~%tlk%~ ~override~
      FOR (r = 1; r < 35; ++r) BEGIN
        SET ref = $hgv_ref(~%r%~)
        PATCH_IF (ref > 0) BEGIN
          LPF hg_tlk_sound INT_VAR strref = ref RET sound END
          SPRINT $hgv_snd(~%r%~) ~%sound%~
        END
      END
  END
  // Classic file name character(s) per sound slot, as the EE Soundset Tool assigns them.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY hgv_suffix BEGIN
     1 => u_   2 => r_   3 => 5_   4 => 6_   5 => j_   6 => b    7 => c    8 => d
     9 => a   10 => 8   11 => 9   12 => g_  13 => h_  14 => c_  15 => d_  16 => e_
    17 => f_  18 => l   19 => m   20 => e   21 => n   22 => o   23 => p   24 => q
    25 => r   26 => f   27 => g   28 => h   29 => 0   30 => k_  31 => l_  32 => i
    33 => j   34 => k
  END
  // The voice's sound files: one per chosen line that has a sound file (a line without
  // one is silent in the game as well). None of them may exist yet: that would be another
  // voice's sound.
  OUTER_SPRINT clash ~~
  OUTER_FOR (r = 1; r < 35; ++r) BEGIN
    OUTER_SPRINT snd $hgv_snd(~%r%~)
    OUTER_SPRINT $hgv_file(~%r%~) ~~
    ACTION_IF NOT (~%snd%~ STRING_EQUAL ~~) AND FILE_EXISTS_IN_GAME ~%snd%.wav~ BEGIN
      OUTER_SPRINT suffix $hgv_suffix(~%r%~)
      OUTER_SPRINT file ~%name%%suffix%~
      OUTER_SPRINT $hgv_file(~%r%~) ~%file%~
      ACTION_IF FILE_EXISTS_IN_GAME ~%file%.wav~ OR FILE_EXISTS ~lang/%EE_LANGUAGE%/sounds/%file%.wav~ BEGIN
        OUTER_SPRINT clash ~%file%.wav~
      END
    END
  END
  ACTION_IF NOT (~%clash%~ STRING_EQUAL ~~) BEGIN
    WARN ~A sound file %clash% exists already; no %name% voice set.~
  END ELSE BEGIN
    // Copy each line's sound under the voice's file name, and write the clean subtitle with
    // that sound into a TRA file.
    OUTER_SPRINT lines ~~
    OUTER_FOR (r = 1; r < 35; ++r) BEGIN
      OUTER_SPRINT file $hgv_file(~%r%~)
      ACTION_IF NOT (~%file%~ STRING_EQUAL ~~) BEGIN
        OUTER_SPRINT snd $hgv_snd(~%r%~)
        OUTER_SPRINT suffix $hgv_suffix(~%r%~)
        ACTION_IF (STRING_LENGTH ~%suffix%~ = 1) BEGIN
          COPY_EXISTING ~%snd%.wav~ ~lang/%EE_LANGUAGE%/sounds/%file%.wav~
        END ELSE BEGIN
          COPY_EXISTING ~%snd%.wav~ ~override/%file%.wav~
        END
        OUTER_SET ref = $hgv_ref(~%r%~)
        ACTION_GET_STRREF ref text
        OUTER_PATCH_SAVE text ~%text%~ BEGIN
          REPLACE_TEXTUALLY ~^[[][^]]*[]] *~ ~~
          REPLACE_TEXTUALLY "~" ""
        END
        OUTER_SET id = 1000 + r
        OUTER_SPRINT lines ~~~~~%lines%@%id% = ~%text%~ [%file%]%WNL%~~~~~
      END
    END
    ACTION_IF NOT (~%lines%~ STRING_EQUAL ~~) BEGIN
      <<<<<<<< .../cbpr-inlined/voice.tra
>>>>>>>>
      COPY ~.../cbpr-inlined/voice.tra~ ~%tra%~
        INSERT_BYTES 0 (STRING_LENGTH ~%lines%~)
        WRITE_ASCIIE 0 ~%lines%~
      LOAD_TRA ~%tra%~
      OUTER_FOR (r = 1; r < 35; ++r) BEGIN
        OUTER_SPRINT file $hgv_file(~%r%~)
        ACTION_IF NOT (~%file%~ STRING_EQUAL ~~) BEGIN
          OUTER_SET id = 1000 + r
          OUTER_SET $hgv_col(~%r%~) = RESOLVE_STR_REF ((AT ~%id%~))
          OUTER_SET slots += 1
        END
      END
    END
    ACTION_IF (slots > 0) BEGIN
      OUTER_SPRINT values ~~
      OUTER_FOR (r = 1; r <= 99; ++r) BEGIN
        OUTER_SET v = (r < 35) ? $hgv_col(~%r%~) : (0 - 1)
        OUTER_SPRINT values ~%values% %v%~
      END
      LAF hg_add_voice_set INT_VAR display STR_VAR name values RET ok END
      ACTION_IF NOT ok BEGIN OUTER_SET slots = 0 END
    END
  END
END

// Whether the current M_cdsnd.lua buffer gives voice `name` a menu name: a line that sets
// filenames_stringrefs['name'] (either quote; commented-out lines do not count).
DEFINE_PATCH_FUNCTION hg_menu_named
  STR_VAR name = ~~
  RET named
BEGIN
  COUNT_REGEXP_INSTANCES CASE_SENSITIVE EVALUATE_REGEXP
    ~^[ %TAB%]*filenames_stringrefs[ %TAB%]*\[[ %TAB%]*['"]%name%['"][ %TAB%]*\]~ n
  SET named = (n > 0)
END

// Register player voice set `name` the way the EE Soundset Tool does: a CHARSND.2DA column
// with `values` (strrefs for rows 1-99, -1 = none) and the menu name `display` in
// M_cdsnd.lua, which other voice packs share (only our line is added, and only when no line
// names `name` yet). Returns 1 when the voice set is registered, 0 when CHARSND.2DA has an
// unexpected layout (warned). A column of that name that is already there is kept as it is.
DEFINE_ACTION_FUNCTION hg_add_voice_set
  INT_VAR display = 0 - 1
  STR_VAR name = ~~
          values = ~~
  RET ok
BEGIN
  OUTER_SET ok = 0
  OUTER_SET present = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~charsnd.2da~ BEGIN
    COPY_EXISTING - ~charsnd.2da~ ~override~
      LPF hg_charsnd_check STR_VAR name RET ok present END
  END
  ACTION_IF NOT ok BEGIN
    WARN ~CHARSND.2DA is missing or lacks the 99 numbered rows the engine expects; no %name% voice set.~
  END ELSE BEGIN
    ACTION_IF present BEGIN
      WARN ~CHARSND.2DA already has a %name% column; kept it.~
    END ELSE BEGIN
      APPEND_COL ~charsnd.2da~ ~$ $ %name%%values%~
      COPY_EXISTING ~charsnd.2da~ ~override~
        PRETTY_PRINT_2DA
    END
    ACTION_IF FILE_EXISTS_IN_GAME ~m_cdsnd.lua~ BEGIN
      OUTER_SET named = 0
      COPY_EXISTING - ~m_cdsnd.lua~ ~override~
        LPF hg_menu_named STR_VAR name RET named END
      ACTION_IF NOT named BEGIN
        APPEND ~m_cdsnd.lua~ ~filenames_stringrefs['%name%'] = {%display%, 2}~
      END
    END ELSE BEGIN
      <<<<<<<< .../cbpr-inlined/M_cdsnd.lua
filenames_stringrefs['%name%'] = {%display%, 2}
>>>>>>>>
      COPY ~.../cbpr-inlined/M_cdsnd.lua~ ~override~
        EVALUATE_BUFFER
    END
  END
END

// Upper-case letter (A-Z) for a character code; empty when it is not a letter.
DEFINE_ACTION_FUNCTION hg_upper_letter
  INT_VAR c = 0
  RET letter
BEGIN
  OUTER_SET u = ((c >= 97) AND (c <= 122)) ? (c - 32) : c
  OUTER_SPRINT letter ~~
  ACTION_IF (u >= 65) AND (u <= 90) BEGIN
    OUTER_PATCH ~ABCDEFGHIJKLMNOPQRSTUVWXYZ~ BEGIN
      READ_ASCII (u - 65) letter (1)
    END
  END
END
